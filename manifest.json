{
  "manifestVersion": 2,
  "id": "hana-yunmusic",
  "name": "HANA云听听",
  "version": "0.20.1",
  "description": "HANA 里的音乐播放器：连接你自己的网易云音乐账号，在线收听、看歌词、按需缓存。非官方客户端，与网易云音乐无关联；只访问你账号本来就能听的内容，音乐与歌词版权归原权利人。",
  "entry": "index.js",
  "icon": "assets/icon.webp",
  "minAppVersion": "0.1050.9",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/input.panels",
    "app/sessions.read"
  ],
  "network": {
    "allowedHosts": [
      "127.0.0.1",
      "*.music.126.net",
      "*.126.net",
      "amlldb.bikonoo.com"
    ],
    "allowLocalhost": true,
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 20000,
    "maxResponseBytes": 8388608
  },
  "contributes": {
    "cards": [
      {
        "id": "console",
        "title": "云听听",
        "description": "音乐播放控制台：封面、进度、播放控制、播放队列、搜索、歌词、我的歌单、红心。",
        "route": "/console.html",
        "realization": "page",
        "pageIcon": "assets/nav.svg",
        "siteNavEntry": true,
        "cardForm": "structural",
        "face": {
          "image": "assets/cover.webp"
        },
        "functionPanel": {
          "id": "mini",
          "label": "正在播放",
          "route": "/mini.html"
        }
      },
      {
        "id": "now",
        "title": "云听听•Mini",
        "description": "紧凑的播放面板：封面、进度、上一下一首与播放控制、音量。钉在工作台上当遥控器，不用打开整页。",
        "route": "/mini.html",
        "realization": "card",
        "cardForm": "structural",
        "face": {
          "image": "assets/cover-mini.webp"
        }
      }
    ]
  }
}
